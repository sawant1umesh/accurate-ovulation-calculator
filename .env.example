# ==============================================================================
# SEO AUTOPILOT - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env and fill in your actual credentials.
# NEVER commit .env to version control.
#
# Primary AI Provider: Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Fallback AI Provider: Groq API
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Autopilot Execution Settings
AUTOPILOT_MAX_RETRIES=2
AUTOPILOT_RETRY_DELAY_MS=1500
AUTOPILOT_TIMEOUT_MS=60000
