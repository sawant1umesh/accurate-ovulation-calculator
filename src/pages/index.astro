---
import Layout from '../layouts/Layout.astro';

const pageTitle = "Ovulation Calculator – Fertile Window & Ovulation Dates";
const pageDescription = "Calculate your fertile window, ovulation date, and pregnancy test timing with our free ovulation calculator. Private, evidence-based, and easy to use.";

const relatedTools = [
  {
    title: "Fertility Calendar",
    description: "Visual 2-month calendar with daily fertility insights, symptom tips, and ICS export.",
    href: "/fertility-calendar",
    color: "brand-sage",
    bgColor: "brand-sage-light",
    borderColor: "brand-sage",
    icon: "grid",
  },
  {
    title: "Due Date Calculator",
    description: "Calculate estimated due date from LMP, conception date, or IVF transfer with trimester milestones.",
    href: "/due-date-calculator",
    color: "brand-gold",
    bgColor: "brand-gold/10",
    borderColor: "brand-gold",
    icon: "clock",
  },
  {
    title: "Pregnancy Test Calculator",
    description: "Find the earliest accurate test date for blood, early urine, and standard home pregnancy tests.",
    href: "/pregnancy-test-calculator",
    color: "brand-rose",
    bgColor: "brand-blush",
    borderColor: "brand-rose-border",
    icon: "beaker",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What is an ovulation calculator?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "An ovulation calculator is a digital tool that estimates your fertile window and predicted ovulation day based on your menstrual cycle information. It typically uses the Ogino-Knaus method, which calculates ovulation by subtracting the luteal phase (usually 14 days) from your cycle length. The calculator identifies the six days each cycle when conception is most likely — the five days before ovulation plus ovulation day itself."
      }
    },
    {
      "@type": "Question",
      "name": "How does an ovulation calculator work?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "An ovulation calculator works by using your last menstrual period (LMP) date and average cycle length to estimate when ovulation occurs. It subtracts the luteal phase length (typically 12–16 days) from your cycle length to pinpoint the estimated ovulation day. The fertile window is then calculated as the five days before that date plus the ovulation day itself, accounting for sperm survival time and egg viability."
      }
    },
    {
      "@type": "Question",
      "name": "How accurate is an ovulation calculator?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "An ovulation calculator provides estimates based on statistical averages and your reported cycle data. For women with regular cycles, these estimates can be reasonably helpful as a starting point. However, accuracy depends on cycle regularity, accurate data entry, and individual biological variation. For best results, combine calculator predictions with physical fertility signs like basal body temperature tracking, cervical mucus observation, and LH ovulation predictor kits."
      }
    },
    {
      "@type": "Question",
      "name": "Can I use an ovulation calculator for irregular periods?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes, many ovulation calculators, including ours, offer a specific mode for irregular cycles. This method uses the Ogino-Knaus formula, which requires your shortest and longest cycle lengths from the past 6–12 months. It calculates a wider, more conservative fertile window to account for cycle variability. While helpful, irregular cycles may benefit from additional tracking methods and guidance from a healthcare professional."
      }
    },
    {
      "@type": "Question",
      "name": "What is a fertile window and why is it important?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The fertile window is the six-day period each menstrual cycle when conception is most likely to occur. It includes the five days before ovulation and ovulation day itself. This window exists because sperm can survive up to five days in fertile cervical mucus, while the released egg remains viable for only 12–24 hours. Timing intercourse during this window gives you the best chance of conception each cycle."
      }
    },
    {
      "@type": "Question",
      "name": "When am I most fertile during my menstrual cycle?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "You are most fertile in the two days leading up to ovulation and on ovulation day itself. During these peak fertility days, the probability of conception per cycle is highest — approximately 25–35% for healthy couples under 35. The day before ovulation and ovulation day carry the greatest likelihood, as the egg is fresh and available for fertilization."
      }
    },
    {
      "@type": "Question",
      "name": "Can I get pregnant outside my fertile window?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "While the probability is significantly lower, it is not impossible to conceive outside the calculated fertile window. Sperm can occasionally survive longer than five days under favorable conditions, and ovulation timing may shift unexpectedly due to stress, illness, or hormonal fluctuations. However, conception chances drop substantially outside the fertile window. An ovulation calculator identifies your highest-probability days, but biological variation means unexpected pregnancies can occur."
      }
    },
    {
      "@type": "Question",
      "name": "Is this a free ovulation calculator?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes, this ovulation calculator is completely free to use with no hidden fees, no account registration required, and no data collection. All calculations run locally in your browser, ensuring your personal health information stays private. You can use it as many times as you like without any cost or limitations."
      }
    },
    {
      "@type": "Question",
      "name": "Is there a 100 percent accurate ovulation calculator?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No ovulation calculator can guarantee 100% accuracy. All ovulation calculators, including ours, provide estimates based on menstrual cycle data and statistical averages. They cannot guarantee ovulation timing, pregnancy, or fertility outcomes. Individual biology varies significantly — even women with regular cycles experience occasional shifts due to stress, illness, travel, or hormonal changes. Results are only estimates, not predictions. If you have irregular cycles, difficulty conceiving, or specific fertility concerns, please consult a qualified healthcare professional such as a reproductive endocrinologist or gynecologist for personalized evaluation and guidance."
      }
    },
    {
      "@type": "Question",
      "name": "What should I do after calculating my ovulation date?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "After calculating your ovulation date, you can plan intercourse during your fertile window for the best chances of conception. Consider combining the calculator results with physical fertility tracking — basal body temperature, cervical mucus observation, and LH predictor kits can help confirm ovulation. You may also want to save your dates to our fertility calendar for visual tracking, start or continue prenatal vitamins, and schedule a preconception appointment with your healthcare provider."
      }
    },
    {
      "@type": "Question",
      "name": "How do I know when I'm ovulating?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Common signs of ovulation include cervical mucus that becomes clear, thin, and stretchy (resembling egg whites), a slight rise in basal body temperature after ovulation, and occasional mild pelvic pain on one side. However, signs vary between individuals and not everyone experiences noticeable symptoms. Combining calendar-based estimates with physical tracking methods like cervical mucus observation and BBT charting can provide a more complete picture."
      }
    },
    {
      "@type": "Question",
      "name": "When should I take a pregnancy test?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Implantation typically occurs 6–10 days after ovulation, which is when hCG begins to be produced. Blood tests can detect hCG as early as 6–8 days post-ovulation, while early urine tests are most reliable from 10–12 days. Standard home pregnancy tests are most accurate when taken after a missed period. Testing too early can result in false negatives because hCG levels may not yet be detectable."
      }
    },
    {
      "@type": "Question",
      "name": "What if I have irregular cycles?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Calendar-based estimates are most reliable for regular cycles. If your cycles vary significantly from month to month, predictions based solely on cycle length may be less accurate. Our calculator offers an irregular cycle mode that uses your shortest and longest cycle lengths to produce a wider fertile window. For irregular cycles, consider combining calculator estimates with physical fertility tracking methods and consulting a healthcare provider for personalized guidance."
      }
    }
  ]
};

const homepageSchema = faqSchema;
---

<Layout title={pageTitle} description={pageDescription} schema={homepageSchema} fullTitle={true}>
  <!-- Hero Section -->
  <section class="relative overflow-hidden bg-canvas-soft">
    <div class="mx-auto max-w-7xl px-5 sm:px-6 lg:px-8 pt-10 pb-12 md:pt-14 md:pb-16 lg:pt-16 lg:pb-20">
      <div class="text-center max-w-3xl mx-auto">
        <!-- Tagline Badge -->
        <span class="inline-flex items-center gap-1.5 text-[11px] font-mono font-semibold tracking-widest text-brand-rose uppercase mb-5 px-4 py-2 rounded-full bg-brand-blush border border-brand-rose-border/50 backdrop-blur-sm">
          <span class="w-1.5 h-1.5 rounded-full bg-brand-rose animate-pulse"></span>
          Clinical-Grade Fertility Intelligence
        </span>

        <!-- Main Heading -->
        <h1 class="text-[2.75rem] md:text-5xl lg:text-[3.75rem] font-semibold tracking-tight text-primary leading-[1.1] max-w-[900px] mx-auto">
          Ovulation Calculator: Know Your Fertile Window<br class="hidden sm:inline"> with Clinical Precision
        </h1>

        <!-- Supporting Paragraph -->
        <p class="mt-5 text-base md:text-lg lg:text-[1.125rem] text-secondary leading-[1.7] max-w-[38rem] mx-auto">
          Our free ovulation calculator provides personalized ovulation predictions, implantation timelines, and pregnancy milestones — calculated locally in your browser for complete privacy.
        </p>

        <!-- Primary CTA - Ovulation Calculator -->
        <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-4">
          <a href="/ovulation-calculator" class="btn-primary h-12 px-8 md:px-10 text-[15px] font-semibold shadow-lg hover:shadow-xl transition-all duration-300 w-full sm:w-auto">
            Start Your Fertility Assessment
          </a>
          <a href="/blog" class="btn-secondary h-12 px-8 md:px-10 text-[15px] font-semibold shadow-sm hover:shadow-md transition-all duration-300 w-full sm:w-auto">
            Explore the Research
          </a>
        </div>

        <!-- Trust Badges -->
        <div class="mt-10 flex flex-wrap items-center justify-center gap-x-8 gap-y-4 text-xs text-secondary/80">
          <div class="flex items-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4 text-brand-sage">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" />
            </svg>
            <span class="font-medium text-secondary">100% Private</span>
          </div>
          <div class="flex items-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4 text-brand-sage">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 3v11.25A2.25 2.25 0 006 16.5h2.25M3.75 3h-1.5m1.5 0h16.5m0 0h1.5m-1.5 0v11.25A2.25 2.25 0 0118 16.5h-2.25m-7.5 0h7.5m-7.5 0l-1 3m8.5-3l1 3m0 0l.5 1.5m-.5-1.5h-9.5m0 0l-.5 1.5m.75-9l3-3 2.148 2.148A12.061 12.061 0 0116.5 7.605" />
            </svg>
            <span class="font-medium text-secondary">Evidence-Based Methods</span>
          </div>
          <div class="flex items-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4 text-brand-sage">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <span class="font-medium text-secondary">Instant Results</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Educational Content Section -->
  <section class="bg-canvas py-16 md:py-24" aria-labelledby="education-heading">
    <div class="mx-auto max-w-7xl px-5 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto space-y-12 md:space-y-16">

        <!-- What Is Ovulation -->
        <article class="prose prose-slate max-w-none">
          <h2 id="education-heading" class="text-2xl md:text-3xl font-semibold tracking-tight text-primary mb-6">Understanding Ovulation and Your Fertile Window</h2>

          <p class="text-base text-secondary leading-relaxed mb-6">
            Ovulation is the release of a mature egg from the ovary into the fallopian tube, where it can be fertilized by sperm. This typically occurs once per menstrual cycle, approximately 14 days before the next period begins. The egg survives for only 12 to 24 hours, while sperm can survive up to five days in fertile cervical mucus — creating a <strong class="text-primary">fertile window of about six days</strong> each cycle.
          </p>

          <h3 class="text-xl font-semibold text-primary mt-8 mb-4">The Four Phases of Your Cycle</h3>
          <ul class="list-disc list-inside space-y-3 text-base text-secondary leading-relaxed">
            <li><strong class="text-primary">Menstrual (Days 1–5):</strong> The uterine lining sheds as estrogen and progesterone reach their lowest levels.</li>
            <li><strong class="text-primary">Follicular (Days 1–13):</strong> Follicle-stimulating hormone (FSH) prompts follicles in the ovary to mature. Rising estrogen thickens the uterine lining in preparation for potential implantation.</li>
            <li><strong class="text-primary">Ovulation (~Day 14):</strong> A surge in luteinizing hormone (LH) triggers the release of a mature egg. This is the peak fertility period.</li>
            <li><strong class="text-primary">Luteal (Days 15–28):</strong> The empty follicle transforms into the corpus luteum, producing progesterone to support the uterine lining. If fertilization does not occur, hormone levels drop and menstruation begins.</li>
          </ul>
        </article>

        <!-- How the Fertile Window Is Estimated -->
        <article class="prose prose-slate max-w-none">
          <h2 class="text-2xl md:text-3xl font-semibold tracking-tight text-primary mb-6">How the Fertile Window Is Estimated</h2>

          <p class="text-base text-secondary leading-relaxed mb-6">
            The fertile window is determined by two biological factors: sperm can survive up to five days in fertile cervical mucus, and the released egg remains viable for only 12 to 24 hours. This means the six days when conception is possible are the five days leading up to ovulation and ovulation day itself.
          </p>

          <p class="text-base text-secondary leading-relaxed mb-6">
            Our calculator uses the <strong class="text-primary">Ogino-Knaus method</strong>, which estimates ovulation by subtracting the luteal phase length (typically 14 days) from your cycle length. For example, with a 28-day cycle, ovulation is estimated around day 14. With a 30-day cycle, it shifts to around day 16. The fertile window is then calculated as the five days before that estimated ovulation date plus ovulation day itself.
          </p>

          <p class="text-base text-secondary leading-relaxed">
            We support three calculation methods: <strong class="text-primary">Last Menstrual Period (LMP)</strong> for regular cycles, <strong class="text-primary">Custom Luteal Phase</strong> for those whose luteal phase differs from 14 days, and <strong class="text-primary">Irregular Cycle mode</strong> using shortest and longest cycle lengths from the past 6–12 months to produce a wider, more conservative fertile window estimate.
          </p>
        </article>

        <!-- Signs of Ovulation -->
        <article class="prose prose-slate max-w-none">
          <h2 class="text-2xl md:text-3xl font-semibold tracking-tight text-primary mb-6">Common Signs of Ovulation</h2>

          <p class="text-base text-secondary leading-relaxed mb-6">
            While calendar-based estimates provide a helpful starting point, many people supplement them with physical observations. Signs of ovulation vary between individuals, and not everyone experiences all of them.
          </p>

          <h3 class="text-xl font-semibold text-primary mt-8 mb-4">Cervical Mucus Changes</h3>
          <p class="text-base text-secondary leading-relaxed mb-6">
            As ovulation approaches, cervical mucus typically becomes clearer, thinner, and more stretchy — resembling raw egg whites. This fertile mucus helps sperm travel toward the egg. After ovulation, mucus often becomes thicker and less plentiful.
          </p>

          <h3 class="text-xl font-semibold text-primary mt-8 mb-4">Basal Body Temperature Shift</h3>
          <p class="text-base text-secondary leading-relaxed mb-6">
            Basal body temperature (BBT) — your temperature at complete rest — tends to rise slightly (about 0.5–1.0°F) after ovulation due to increased progesterone. Tracking BBT daily can help confirm that ovulation has occurred, though it does not predict ovulation in advance.
          </p>

          <h3 class="text-xl font-semibold text-primary mt-8 mb-4">Other Possible Signs</h3>
          <p class="text-base text-secondary leading-relaxed">
            Some people notice mild mid-cycle pelvic pain (known as mittelschmerz), breast tenderness, or a slight increase in libido around ovulation. These signs are subjective and vary widely. For the most reliable fertility awareness, consider combining multiple tracking methods — cervical mucus observation, BBT charting, and LH predictor kits — alongside calendar-based estimates.
          </p>
        </article>

        <!-- Cycle Length and Ovulation -->
        <article class="prose prose-slate max-w-none">
          <h2 class="text-2xl md:text-3xl font-semibold tracking-tight text-primary mb-6">How Cycle Length Affects Ovulation Timing</h2>

          <p class="text-base text-secondary leading-relaxed mb-6">
            Not everyone has a 28-day cycle, and ovulation timing shifts accordingly. The luteal phase (the time between ovulation and your next period) is relatively consistent at 12–16 days for most people. However, the follicular phase (the time before ovulation) can vary significantly.
          </p>

          <p class="text-base text-secondary leading-relaxed mb-6">
            This means ovulation typically occurs earlier in shorter cycles and later in longer cycles. For example:
          </p>

          <ul class="list-disc list-inside space-y-3 text-base text-secondary leading-relaxed">
            <li><strong class="text-primary">24-day cycle:</strong> Ovulation may occur around day 10</li>
            <li><strong class="text-primary">28-day cycle:</strong> Ovulation may occur around day 14</li>
            <li><strong class="text-primary">32-day cycle:</strong> Ovulation may occur around day 18</li>
            <li><strong class="text-primary">35-day cycle:</strong> Ovulation may occur around day 21</li>
          </ul>

          <p class="text-base text-secondary leading-relaxed mt-6">
            If your cycle length varies by a few days from month to month, the calculator provides an estimate based on the average cycle length you enter. For greater precision, you can track your cycles over several months and use your actual average.
          </p>
        </article>

        <!-- Irregular Cycles -->
        <article class="prose prose-slate max-w-none">
          <h2 class="text-2xl md:text-3xl font-semibold tracking-tight text-primary mb-6">Irregular Cycles and Additional Considerations</h2>

          <p class="text-base text-secondary leading-relaxed mb-6">
            Calendar-based estimates are most reliable for people with regular menstrual cycles. If your cycles are irregular — meaning they vary by more than a few days each month — predictions based solely on cycle length may be less accurate.
          </p>

          <p class="text-base text-secondary leading-relaxed mb-6">
            For irregular cycles, our calculator offers a specialized mode that uses your shortest and longest cycle lengths from the past 6–12 months. This produces a wider fertile window to account for cycle variability. However, even with this approach, calendar methods have limitations when cycles are highly unpredictable.
          </p>

          <p class="text-base text-secondary leading-relaxed">
            If you have irregular cycles, you may benefit from combining calculator estimates with additional fertility-awareness methods such as cervical mucus tracking, BBT charting, and LH predictor kits. Persistent irregularity or difficulty conceiving warrant a consultation with a healthcare provider who can evaluate potential underlying factors.
          </p>
        </article>

        <!-- When to Take a Pregnancy Test -->
        <article class="prose prose-slate max-w-none">
          <h2 class="text-2xl md:text-3xl font-semibold tracking-tight text-primary mb-6">When to Take a Pregnancy Test</h2>

          <p class="text-base text-secondary leading-relaxed mb-6">
            After ovulation, implantation typically occurs 6 to 10 days later. This is when a fertilized egg attaches to the uterine lining and begins producing human chorionic gonadotropin (hCG) — the hormone detected by pregnancy tests.
          </p>

          <p class="text-base text-secondary leading-relaxed mb-6">
            For the most reliable results:
          </p>

          <ul class="list-disc list-inside space-y-3 text-base text-secondary leading-relaxed">
            <li><strong class="text-primary">Blood tests:</strong> Can detect hCG as early as 6–8 days after ovulation</li>
            <li><strong class="text-primary">Early urine tests:</strong> Most reliable from 10–12 days after ovulation</li>
            <li><strong class="text-primary">Standard home tests:</strong> Most accurate when taken after a missed period</li>
          </ul>

          <p class="text-base text-secondary leading-relaxed mt-6">
            Testing too early can produce false negatives because hCG levels may not yet be detectable. If you test early and get a negative result but still suspect pregnancy, wait a few days and test again.
          </p>
        </article>

        <!-- Calculator Limitations -->
        <article class="prose prose-slate max-w-none">
          <div class="rounded-xl bg-canvas-soft-2 p-6 md:p-8 border border-hairline">
            <h2 class="text-xl md:text-2xl font-semibold text-primary mb-4">Important: What This Calculator Can and Cannot Do</h2>
            <p class="text-base text-secondary leading-relaxed mb-4">
              This calculator provides <strong class="text-primary">estimates for educational purposes only</strong>. It uses statistical averages and your reported cycle data to suggest when ovulation and your fertile window may occur. It <strong class="text-primary">cannot confirm ovulation, predict fertility with certainty, or diagnose any medical condition</strong>.
            </p>
            <p class="text-base text-secondary leading-relaxed mb-4">
              Individual biology varies significantly. Even people with regular cycles experience occasional shifts due to stress, illness, travel, or hormonal changes. Results are estimates, not guarantees.
            </p>
            <p class="text-base text-secondary leading-relaxed">
              This tool <strong class="text-primary">does not diagnose, treat, prevent, or cure any medical condition</strong> and must never be used as a method of contraception. Always consult a qualified healthcare provider for personalized medical guidance regarding fertility, pregnancy, or reproductive health concerns.
            </p>
          </div>
        </article>

      </div>
    </div>
  </section>

  <!-- Related Tools Section -->
  <section class="bg-canvas-soft py-12 md:py-16" aria-labelledby="related-tools-heading">
    <div class="mx-auto max-w-7xl px-5 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-8 md:mb-10">
        <span class="text-[11px] font-mono font-semibold tracking-widest text-brand-rose uppercase">
          Related Tools
        </span>
        <h2 id="related-tools-heading" class="text-xl md:text-2xl font-semibold tracking-tight text-primary mt-2 mb-3">
          Other Fertility Calculators
        </h2>
        <p class="text-sm text-secondary leading-relaxed max-w-xl mx-auto">
          Additional tools for your fertility journey. Each runs privately in your browser.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 max-w-4xl mx-auto">
        {relatedTools.map((tool) => (
          <a
            href={tool.href}
            class="card-container group hover:shadow-md transition-all duration-200 p-5"
          >
            <div class="flex items-start gap-3">
              <span class={`flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-${tool.bgColor} border border-${tool.borderColor} text-${tool.color} transition-all duration-200 group-hover:scale-105`}>
                {tool.icon === 'grid' && (
                  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6A2.25 2.25 0 016 3.75h2.25A2.25 2.25 0 0110.5 6v2.25a2.25 2.25 0 01-2.25 2.25H6a2.25 2.25 0 01-2.25-2.25V6zM3.75 15.75A2.25 2.25 0 016 13.5h2.25a2.25 2.25 0 012.25 2.25V18a2.25 2.25 0 01-2.25 2.25H6A2.25 2.25 0 013.75 18v-2.25zM13.5 6a2.25 2.25 0 012.25-2.25H18A2.25 2.25 0 0120.25 6v2.25A2.25 2.25 0 0118 10.5h-2.25a2.25 2.25 0 01-2.25-2.25V6zM13.5 15.75a2.25 2.25 0 012.25-2.25H18a2.25 2.25 0 012.25 2.25V18A2.25 2.25 0 0118 20.25h-2.25A2.25 2.25 0 0113.5 18v-2.25z" />
                  </svg>
                )}
                {tool.icon === 'clock' && (
                  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" />
                  </svg>
                )}
                {tool.icon === 'beaker' && (
                  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9.75 3.104v5.714a2.25 2.25 0 01-.659 1.591L5 14.5M9.75 3.104c-.251.023-.501.05-.75.082m.75-.082a24.301 24.301 0 014.5 0m0 0v5.714c0 .597.237 1.17.659 1.591L19.8 15.3M14.25 3.104c.251.023.501.05.75.082M19.8 15.3l-1.57.393A9.065 9.065 0 0112 15a9.065 9.065 0 00-6.23.693L5 14.5m14.8.8l1.402 1.402c1.232 1.232.65 3.318-1.067 3.611A48.309 48.309 0 0112 21c-2.773 0-5.491-.235-8.135-.687-1.718-.293-2.3-2.379-1.067-3.61L5 14.5" />
                  </svg>
                )}
