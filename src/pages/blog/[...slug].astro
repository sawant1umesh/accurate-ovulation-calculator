---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": post.data.title,
  "description": post.data.description,
  "author": {
    "@type": "Person",
    "name": post.data.author
  },
  "datePublished": post.data.pubDate.toISOString(),
  "publisher": {
    "@type": "Organization",
    "name": "Accurate Ovulation Calculator",
    "logo": {
      "@type": "ImageObject",
      "url": "https://accurateovulationcalculator.com/logo-optimized.png"
    }
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": `https://accurateovulationcalculator.com/blog/${post.id}`
  }
};

const schemas = [articleSchema];

if (post.data.faqs && post.data.faqs.length > 0) {
  const faqPageSchema = {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": post.data.faqs.map((faq: { question: string; answer: string }) => ({
      "@type": "Question",
      "name": faq.question,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": faq.answer
      }
    }))
  };
  schemas.push(faqPageSchema);
}
---

<Layout
  title={`${post.data.title} | Accurate Ovulation Calculator`}
  description={post.data.description}
  schemas={schemas}
>
  <article class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8 py-10 md:py-16">
    <!-- Back Navigation -->
    <nav class="mb-8">
      <a
        href="/blog"
        class="inline-flex items-center gap-1.5 text-xs font-medium text-secondary hover:text-primary transition-colors"
      >
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-3.5 h-3.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" />
        </svg>
        Back to Blog
      </a>
    </nav>

    <!-- Article Header -->
    <header class="mb-10 md:mb-14">
      <div class="flex items-center gap-3 text-[10px] font-mono uppercase tracking-wider text-secondary mb-4">
        <span class="text-brand-rose font-semibold">{post.data.category}</span>
        <span class="w-1 h-1 rounded-full bg-hairline-strong"></span>
        <span>{post.data.readTime}</span>
      </div>

      <h1 class="text-3xl md:text-4xl font-semibold tracking-tight text-primary leading-tight mb-6">
        {post.data.title}
      </h1>

      <p class="text-base text-secondary leading-relaxed mb-6">
        {post.data.description}
      </p>

      <div class="flex items-center gap-4 pt-6 border-t border-hairline">
        <div class="flex items-center gap-3">
          <span class="flex h-8 w-8 items-center justify-center rounded-full bg-brand-blush border border-brand-rose-border text-brand-rose text-xs font-semibold">
            {post.data.author.split(' ').map((n: string) => n[0]).join('').slice(0, 2)}
          </span>
          <div>
            <span class="text-xs font-medium text-primary block">{post.data.author}</span>
            <span class="text-[10px] font-mono text-secondary">
              {post.data.pubDate.toLocaleDateString('en-US', {
                month: 'long',
                day: 'numeric',
                year: 'numeric'
              })}
            </span>
          </div>
        </div>
      </div>
    </header>

    <!-- Article Content -->
    <div class="prose-custom">
      <Content />
    </div>

    <!-- Article Footer -->
    <footer class="mt-12 md:mt-16 pt-8 border-t border-hairline">
      <div class="card-container bg-canvas-soft-2">
        <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
          <div>
            <h3 class="text-sm font-semibold text-primary mb-1">Found this article helpful?</h3>
            <p class="text-xs text-secondary">Share it with someone who might benefit from evidence-based fertility education.</p>
          </div>
          <a href="/blog" class="btn-secondary text-xs h-9 px-4 shrink-0">
            Browse More Articles
          </a>
        </div>
      </div>
    </footer>
  </article>
</Layout>

<style>
  .prose-custom :global(h2) {
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--color-primary);
    margin-top: 2rem;
    margin-bottom: 0.75rem;
    letter-spacing: -0.02em;
    line-height: 1.3;
  }

  .prose-custom :global(h3) {
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--color-primary);
    margin-top: 1.5rem;
    margin-bottom: 0.5rem;
  }

  .prose-custom :global(p) {
    font-size: 0.9375rem;
    color: var(--color-secondary);
    line-height: 1.75;
    margin-bottom: 1rem;
  }

  .prose-custom :global(ul),
  .prose-custom :global(ol) {
    margin-bottom: 1rem;
    padding-left: 1.25rem;
  }

  .prose-custom :global(li) {
    font-size: 0.9375rem;
    color: var(--color-secondary);
    line-height: 1.75;
    margin-bottom: 0.375rem;
  }

  .prose-custom :global(ol) {
    list-style-type: decimal;
  }

  .prose-custom :global(ul) {
    list-style-type: disc;
  }

  .prose-custom :global(strong) {
    font-weight: 600;
    color: var(--color-primary);
  }

  .prose-custom :global(em) {
    font-style: italic;
  }

  .prose-custom :global(a) {
    color: var(--color-brand-rose);
    text-decoration: underline;
    text-underline-offset: 2px;
    transition: color 0.15s ease;
  }

  .prose-custom :global(a:hover) {
    color: var(--color-primary);
  }

  /* Inline Code */
  .prose-custom :global(:not(pre) > code) {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    background-color: var(--color-canvas-soft-2);
    color: var(--color-primary);
    border: 1px solid var(--color-hairline-strong);
    border-radius: var(--radius-sm);
    padding: 0.125rem 0.375rem;
    font-weight: 500;
  }

  /* Code Blocks & Preformatted Diagrams */
  .prose-custom :global(pre),
  .prose-custom :global(pre.astro-code) {
    background-color: var(--color-canvas-soft-2) !important;
    color: var(--color-primary) !important;
    border: 1px solid var(--color-hairline-strong) !important;
    border-radius: var(--radius-md) !important;
    padding: 1.25rem 1.5rem !important;
    margin: 1.75rem 0 !important;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    line-height: 1.6;
    overflow-x: auto;
    max-width: 100%;
    box-shadow: var(--shadow-sm);
    -webkit-overflow-scrolling: touch;
  }

  /* Reset inner code inside pre */
  .prose-custom :global(pre code) {
    background-color: transparent !important;
    border: none !important;
    border-radius: 0 !important;
    padding: 0 !important;
    color: inherit !important;
    font-size: inherit !important;
    font-family: inherit !important;
    display: block;
    white-space: pre;
  }

  .prose-custom :global(pre .line),
  .prose-custom :global(pre span) {
    color: inherit !important;
  }

  /* Tables */
  .prose-custom :global(table) {
    display: block;
    width: 100%;
    max-width: 100%;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    border-collapse: separate;
    border-spacing: 0;
    margin: 1.75rem 0;
    font-size: 0.875rem;
    line-height: 1.6;
    border: 1px solid var(--color-hairline-strong);
    border-radius: var(--radius-md);
    background-color: var(--color-canvas);
    box-shadow: var(--shadow-sm);
  }

  .prose-custom :global(thead) {
    background-color: var(--color-canvas-soft-2);
  }

  .prose-custom :global(th) {
    padding: 0.875rem 1rem;
    font-weight: 600;
    color: var(--color-primary);
    text-align: left;
    border-bottom: 1px solid var(--color-hairline-strong);
    border-right: 1px solid var(--color-hairline);
    font-size: 0.8125rem;
    white-space: nowrap;
    letter-spacing: -0.01em;
  }

  .prose-custom :global(th:last-child) {
    border-right: none;
  }

  .prose-custom :global(td) {
    padding: 0.875rem 1rem;
    color: var(--color-secondary);
    border-bottom: 1px solid var(--color-hairline);
    border-right: 1px solid var(--color-hairline);
    vertical-align: top;
    font-size: 0.875rem;
    min-width: 130px;
  }

  .prose-custom :global(td:last-child) {
    border-right: none;
  }

  .prose-custom :global(tr:last-child td) {
    border-bottom: none;
  }

  .prose-custom :global(tbody tr:nth-child(even)) {
    background-color: var(--color-canvas-soft);
  }

  .prose-custom :global(tbody tr:hover) {
    background-color: var(--color-brand-blush);
  }

  .prose-custom :global(blockquote) {
    border-left: 3px solid var(--color-brand-rose);
    background-color: var(--color-canvas-soft);
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
    padding: 1rem 1.25rem;
    margin: 1.5rem 0;
    font-style: italic;
    color: var(--color-secondary);
  }

  .prose-custom :global(hr) {
    border: none;
    border-top: 1px solid var(--color-hairline);
    margin: 2.5rem 0;
  }

  /* Diagrams & Visual Architecture */
  .prose-custom :global(.diagram-card) {
    background-color: var(--color-canvas-soft-2);
    border: 1px solid var(--color-hairline-strong);
    border-radius: var(--radius-lg);
    padding: 1.5rem;
    margin: 2rem 0;
    box-shadow: var(--shadow-sm);
  }

  @media (min-width: 640px) {
    .prose-custom :global(.diagram-card) {
      padding: 2rem;
    }
  }

  .prose-custom :global(.diagram-node) {
    background-color: var(--color-canvas);
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-md);
    padding: 0.875rem 1rem;
    box-shadow: 0 1px 2px rgba(45, 36, 38, 0.04);
  }

  .prose-custom :global(.diagram-badge) {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 0.2rem 0.5rem;
    border-radius: var(--radius-xs);
  }
</style>
