---
import Layout from '../layouts/Layout.astro';

// SEO Title & Description (50-60 chars, 150-160 chars)
const pageTitle = "Due Date Calculator – Pregnancy Due Date by LMP, Conception, or IVF";
const pageDescription = "Calculate your estimated due date using LMP, conception date, or IVF transfer. Get gestational age, trimester timeline, and pregnancy milestones. Free, private, no account.";

// Canonical URL
const canonicalUrl = "https://accurateovulationcalculator.com/due-date-calculator";

// Open Graph Image (page-specific if available)
const ogImage = "https://accurateovulationcalculator.com/og-due-date-calculator.jpg";

// Calculator JSON-LD Schema
const calculatorSchema = {
  "@context": "https://schema.org",
  "@type": "Calculator",
  "name": "Due Date Calculator",
  "description": "Calculates estimated pregnancy due date and milestone timelines using LMP, conception date, or IVF embryo transfer dates.",
  "category": "Pregnancy Calculator",
  "url": "https://accurateovulationcalculator.com/due-date-calculator"
};

// FAQ Schema for Due Date Calculator
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "How is my due date calculated from my last menstrual period (LMP)?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Your due date is calculated using Naegele's rule: add 280 days (40 weeks) to the first day of your last menstrual period. This assumes a 28-day cycle with ovulation on day 14. Our calculator adjusts for your actual cycle length — if your cycle is 32 days, 4 days are added; if 24 days, 4 days are subtracted."
      }
    },
    {
      "@type": "Question",
      "name": "What is Naegele's rule and how accurate is it?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Naegele's rule is the standard method for estimating due dates: LMP + 7 days − 3 months + 1 year = due date (equivalent to LMP + 280 days). It's a population-level estimate; only about 4–5% of babies arrive on their exact due date. Accuracy improves with early ultrasound confirmation (±3–5 days at 7–13 weeks)."
      }
    },
    {
      "@type": "Question",
      "name": "How does my cycle length affect my due date calculation?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Cycle length shifts ovulation timing, which changes the conception date. The standard 280-day formula assumes ovulation on day 14. For a 32-day cycle (ovulation ~day 18), add 4 days to the due date. For a 24-day cycle (ovulation ~day 10), subtract 4 days. Our calculator automatically applies this adjustment when you enter your average cycle length."
      }
    },
    {
      "@type": "Question",
      "name": "How is the due date calculated if I know my conception date?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "When conception date is known (via ovulation tracking, BBT, or OPKs), the due date is calculated by adding 266 days (38 weeks) from conception. This is more precise than LMP-based dating because it removes the variability of cycle length and ovulation timing. Our conception date method uses this 266-day formula."
      }
    },
    {
      "@type": "Question",
      "name": "How are IVF due dates calculated for embryo transfers?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "IVF due dates are calculated from the embryo transfer date based on embryo age at transfer. For a 5-day blastocyst transfer, add 261 days (37 weeks + 2 days). For a 3-day cleavage-stage transfer, add 263 days (37 weeks + 4 days). These intervals align with ASRM and SART guidelines and account for the embryo's developmental age before transfer."
      }
    },
    {
      "@type": "Question",
      "name": "What is the difference between gestational age and fetal age?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Gestational age counts from the first day of your LMP (approximately 2 weeks before conception) and is the standard used by healthcare providers. Fetal age (embryonic age) counts from the actual conception date. Our calculator displays gestational age — this is why you may be '4 weeks pregnant' before implantation occurs."
      }
    },
    {
      "@type": "Question",
      "name": "How accurate are due date calculators compared to ultrasound?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Due date calculators provide estimates based on population averages. Early ultrasound (crown-rump length at 7–13 weeks) is the gold standard with ±3–5 day accuracy. LMP-based calculators can be off by 1–2 weeks, especially with irregular cycles, recent hormonal birth control, or uncertain LMP recall. Always confirm dating with your provider via ultrasound."
      }
    },
    {
      "@type": "Question",
      "name": "Can my due date change after an ultrasound?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. If early ultrasound dating differs from your LMP-based due date by more than 5–7 days (first trimester) or 10–14 days (second trimester), your provider will typically update your due date to match the ultrasound. First-trimester ultrasound is most reliable for dating; later ultrasounds assess growth rather than establish dates."
      }
    },
    {
      "@type": "Question",
      "name": "What do the pregnancy trimesters mean for my due date timeline?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Trimesters divide the 40-week gestational period: First trimester (weeks 0–13) covers organogenesis; second trimester (weeks 14–27) includes anatomy scan and quickening; third trimester (weeks 28–40) covers lung maturation and weight gain. Full term is 39–40 weeks; early term 37–38 weeks; late term 41 weeks; post-term ≥42 weeks. Our calculator shows your current trimester and progress bar."
      }
    },
    {
      "@type": "Question",
      "name": "What happens if my due date passes and I haven't delivered?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Only ~4–5% of babies arrive on their exact due date. Most deliver between 39–41 weeks. If you reach 41 weeks (late term), your provider will discuss monitoring (non-stress tests, biophysical profile) and may recommend induction. At ≥42 weeks (post-term), induction is typically advised due to increased risks. Always follow your provider's guidance for post-dates management."
      }
    }
  ]
};
---

<Layout title={pageTitle} description={pageDescription} canonical={canonicalUrl} ogImage={ogImage} schema={calculatorSchema}>
  <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 py-10 md:py-16">
    <!-- Header -->
    <div class="text-center max-w-2xl mx-auto mb-10 md:mb-16">
      <span class="text-xs font-mono font-semibold tracking-wider text-brand-gold uppercase">
        Pregnancy Milestones
      </span>
      <h1 class="text-3xl md:text-4xl font-semibold tracking-tight text-primary mt-2 mb-4">
        Calculate Your Pregnancy Due Date.
      </h1>
      <p class="text-sm md:text-base text-secondary leading-relaxed">
        Determine your baby's estimated arrival and plan for key developmental milestones. Choose between LMP, conception, or IVF calculation methods below.
      </p>
    </div>

    <!-- Calculator Input Box -->
    <div class="card-container mb-12">
      <!-- Tabs -->
      <div role="tablist" class="flex border-b border-hairline mb-8 overflow-x-auto whitespace-nowrap scrollbar-none" aria-label="Calculation method">
        <button
          type="button"
          id="due-tab-lmp"
          role="tab"
          aria-selected="true"
          aria-controls="panel-lmp"
          class="px-5 py-3 text-sm font-semibold border-b-2 border-brand-gold text-primary focus:outline-none transition-all cursor-pointer"
        >
          Last Period (LMP)
        </button>
        <button
          type="button"
          id="due-tab-conception"
          role="tab"
          aria-selected="false"
          aria-controls="panel-conception"
          tabindex="-1"
          class="px-5 py-3 text-sm font-medium border-b-2 border-transparent text-secondary hover:text-primary focus:outline-none transition-all cursor-pointer"
        >
          Conception Date
        </button>
        <button
          type="button"
          id="due-tab-ivf"
          role="tab"
          aria-selected="false"
          aria-controls="panel-ivf"
          tabindex="-1"
          class="px-5 py-3 text-sm font-medium border-b-2 border-transparent text-secondary hover:text-primary focus:outline-none transition-all cursor-pointer"
        >
          IVF Transfer
        </button>
      </div>

      <form id="due-calculator-form" class="space-y-6">
        <input type="hidden" id="due-method" name="method" value="lmp" />

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <!-- Main Date Selector -->
          <div>
            <label id="date-input-label" for="base-date" class="block text-xs font-semibold text-primary uppercase font-mono tracking-wider mb-2">
              First Day of Last Period
            </label>
            <input
              type="date"
              id="base-date"
              name="baseDate"
              required
              class="w-full h-10 px-4 border border-hairline-strong rounded-sm text-sm focus:outline-none focus:ring-1 focus:ring-primary focus:border-primary bg-canvas text-primary hover:border-primary transition-all"
            />
          </div>

          <!-- Cycle Length (LMP Method only) -->
          <div id="due-cycle-wrapper">
            <label for="due-cycle" class="block text-xs font-semibold text-primary uppercase font-mono tracking-wider mb-2">
              Average Cycle Length: <span id="due-cycle-val" class="font-bold text-brand-gold">28</span> Days
            </label>
            <input
              type="range"
              id="due-cycle"
              name="cycleLength"
              min="20"
              max="45"
              value="28"
              class="w-full accent-brand-gold cursor-pointer h-2 bg-canvas-soft-2 rounded-lg appearance-none border border-hairline"
            />
          </div>

          <!-- IVF Options (IVF Method only) -->
          <div id="due-ivf-wrapper" class="hidden">
            <label for="ivf-type" class="block text-xs font-semibold text-primary uppercase font-mono tracking-wider mb-2">
              Embryo Age
            </label>
            <select
              id="ivf-type"
              name="ivfType"
              class="w-full h-10 px-4 border border-hairline-strong rounded-sm text-sm focus:outline-none focus:ring-1 focus:ring-primary focus:border-primary bg-canvas text-primary hover:border-primary transition-all"
            >
              <option value="3day">3-Day Embryo Transfer</option>
              <option value="5day" selected>5-Day Embryo Transfer (Blastocyst)</option>
            </select>
          </div>
        </div>

        <div>
          <button type="submit" class="btn-primary bg-primary hover:bg-brand-gold border hover:border-brand-gold w-full md:w-auto px-8 font-semibold">
            Calculate Due Date
          </button>
        </div>
      </form>
    </div>

    <!-- Results Panel -->
    <div id="due-results" class="hidden space-y-8 animate-fade-in">
      <!-- Main Stat Results -->
      <div class="card-container bg-canvas flex flex-col md:flex-row justify-between items-start md:items-center gap-8">
        <div>
          <span class="text-xs font-mono font-semibold text-brand-gold uppercase block">Estimated Delivery Date</span>
          <h2 id="result-due-date" class="text-3xl md:text-4xl font-semibold text-primary mt-1 mb-2"></h2>
          <p id="result-days-left" class="text-xs text-secondary"></p>
        </div>

        <div class="pt-4 md:pt-0 md:border-l md:border-hairline md:pl-8 flex-grow">
          <span class="text-xs font-mono text-secondary uppercase block">Gestational Age</span>
          <h3 id="result-gestational-age" class="text-xl font-semibold text-primary mt-1"></h3>
          <p id="result-trimester" class="text-xs text-brand-gold font-medium mt-1"></p>
        </div>
      </div>

      <!-- Trimester Progress Bar -->
      <div class="card-container">
        <h3 class="text-sm font-semibold text-primary mb-4">Pregnancy Trimester Timeline</h3>
        
        <div class="relative w-full bg-canvas-soft-2 border border-hairline h-6 rounded-full flex overflow-hidden mb-2">
          <div id="bar-tri-1" class="h-full bg-brand-blush/60 border-r border-hairline flex items-center justify-center text-[10px] font-semibold text-primary transition-all" style="width: 0%">Tri 1</div>
          <div id="bar-tri-2" class="h-full bg-brand-gold/20 border-r border-hairline flex items-center justify-center text-[10px] font-semibold text-primary transition-all" style="width: 0%">Tri 2</div>
          <div id="bar-tri-3" class="h-full bg-brand-sage-light flex items-center justify-center text-[10px] font-semibold text-primary transition-all" style="width: 0%">Tri 3</div>
        </div>
        
        <div class="flex justify-between text-[10px] text-secondary font-mono px-1">
          <span>Week 0</span>
          <span>Week 14 (Trimester 2)</span>
          <span>Week 28 (Trimester 3)</span>
          <span>Week 40 (Due Date)</span>
        </div>
      </div>

      <!-- Developmental Milestones -->
      <div class="card-container">
        <h3 class="text-sm font-semibold text-primary mb-6">Pregnancy Milestones & Developmental Timeline</h3>
        
        <div class="space-y-6 relative before:absolute before:left-3 before:top-2 before:bottom-2 before:w-0.5 before:bg-hairline">
          <!-- Conception -->
          <div class="flex gap-4 relative">
            <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-brand-blush border border-brand-rose-border text-[10px] text-primary font-bold z-10 shadow-sm">1</span>
            <div>
              <h4 class="text-xs font-semibold text-primary">Conception Date (Est.)</h4>
              <span id="milestone-conception" class="text-[10px] font-mono text-secondary"></span>
              <p class="text-xs text-secondary mt-1">Egg and sperm fuse, beginning cell division and journey to the uterus.</p>
            </div>
          </div>

          <!-- Heartbeat -->
          <div class="flex gap-4 relative">
            <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-brand-blush border border-brand-rose-border text-[10px] text-primary font-bold z-10 shadow-sm">2</span>
            <div>
              <h4 class="text-xs font-semibold text-primary">First Fetal Heartbeat (Week 6)</h4>
              <span id="milestone-heartbeat" class="text-[10px] font-mono text-secondary"></span>
              <p class="text-xs text-secondary mt-1">The cardiac cells begin rhythmically pulsing, detectable via ultrasound.</p>
            </div>
          </div>

          <!-- First Kick -->
          <div class="flex gap-4 relative">
            <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-brand-gold/20 border border-brand-gold text-[10px] text-primary font-bold z-10 shadow-sm">3</span>
            <div>
              <h4 class="text-xs font-semibold text-primary">First Kicks / Quickening (Week 18)</h4>
              <span id="milestone-kick" class="text-[10px] font-mono text-secondary"></span>
              <p class="text-xs text-secondary mt-1">The mother typically begins to feel the baby's voluntary movements.</p>
            </div>
          </div>

          <!-- Viability -->
          <div class="flex gap-4 relative">
            <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-brand-sage-light border border-brand-sage text-[10px] text-primary font-bold z-10 shadow-sm">4</span>
            <div>
              <h4 class="text-xs font-semibold text-primary">Fetal Viability (Week 24)</h4>
              <span id="milestone-viability" class="text-[10px] font-mono text-secondary"></span>
              <p class="text-xs text-secondary mt-1">Baby has built structures viable for life outside the womb with intensive care.</p>
            </div>
          </div>

          <!-- Full Term -->
          <div class="flex gap-4 relative">
            <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-brand-sage-light border border-brand-sage text-[10px] text-primary font-bold z-10 shadow-sm">5</span>
            <div>
              <h4 class="text-xs font-semibold text-primary">Reached Full Term (Week 37)</h4>
              <span id="milestone-term" class="text-[10px] font-mono text-secondary"></span>
              <p class="text-xs text-secondary mt-1">Baby's lungs and organs are fully mature and prepared for birth.</p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Educational Content Section -->
    <section class="mt-16 md:mt-24 max-w-3xl mx-auto space-y-10" aria-labelledby="education-heading">
      <h2 id="education-heading" class="text-2xl md:text-3xl font-semibold text-primary text-center">
        Understanding Your Due Date Calculation
      </h2>

      <article class="prose prose-sm text-secondary max-w-none">
        <p class="leading-relaxed">
          A <strong>due date calculator</strong> estimates when your baby will arrive based on the first day of your last menstrual period (LMP), conception date, or IVF embryo transfer date. The standard calculation uses Naegele's rule — adding 280 days (40 weeks) to the first day of your LMP — which assumes a 28-day cycle with ovulation on day 14.
        </p>

        <h3 class="text-lg font-semibold text-primary mt-8 mb-3">Calculation Methods Explained</h3>
        <ul class="list-disc list-inside space-y-3 text-sm leading-relaxed">
          <li>
            <strong>LMP Method:</strong> Most common approach. Enter the first day of your last period and your average cycle length. Our calculator adjusts the standard 280-day formula for cycles shorter or longer than 28 days (e.g., a 32-day cycle adds 4 days to the due date).
          </li>
          <li>
            <strong>Conception Date Method:</strong> If you know your ovulation or conception date (from <a href="/ovulation-calculator" class="text-brand-rose underline hover:no-underline">ovulation tracking</a>, basal body temperature, or OPKs), this method adds 266 days (38 weeks) from conception — more precise when ovulation timing is confirmed.
          </li>
          <li>
            <strong>IVF Transfer Method:</strong> For fertility treatment pregnancies, the due date is calculated from the embryo transfer date. A 5-day blastocyst transfer adds 261 days; a 3-day cleavage-stage transfer adds 263 days. This aligns with ASRM and SART guidelines.
          </li>
        </ul>

        <h3 class="text-lg font-semibold text-primary mt-8 mb-3">Gestational Age vs. Fetal Age</h3>
        <p class="leading-relaxed mt-3">
          <strong>Gestational age</strong> (what doctors use) counts from the first day of your LMP — approximately two weeks before conception occurs. <strong>Fetal age</strong> (embryonic age) counts from conception. Our calculator displays gestational age, which is why you may be "4 weeks pregnant" before implantation even occurs. This standardization allows consistent tracking across ultrasounds, lab tests, and clinical milestones.
        </p>

        <h3 class="text-lg font-semibold text-primary mt-8 mb-3">Trimester Breakdown</h3>
        <ul class="list-disc list-inside space-y-2 text-sm leading-relaxed">
          <li><strong>First Trimester (Weeks 0–13):</strong> Organogenesis — major organs and structures form. Highest risk period for miscarriage and teratogen exposure.</li>
          <li><strong>Second Trimester (Weeks 14–27):</strong> Rapid growth, fetal movement begins (quickening ~18–22 weeks), anatomy scan typically at 18–22 weeks.</li>
          <li><strong>Third Trimester (Weeks 28–40):</strong> Lung maturation, fat accumulation, brain development. <strong>Early term:</strong> 37–38 weeks; <strong>Full term:</strong> 39–40 weeks; <strong>Late term:</strong> 41 weeks; <strong>Post-term:</strong> ≥42 weeks.</li>
        </ul>

        <h3 class="text-lg font-semibold text-primary mt-8 mb-3">Accuracy & Limitations</h3>
        <p class="leading-relaxed mt-3">
          Due dates are estimates — only about 4–5% of babies arrive on their exact due date. Early ultrasound dating (crown-rump length at 7–13 weeks) is the gold standard for accuracy (±3–5 days). LMP-based calculations can be off by 1–2 weeks, especially with irregular cycles, recent hormonal contraception, or uncertain LMP recall. Always confirm dating with your healthcare provider via ultrasound.
        </p>

        <h3 class="text-lg font-semibold text-primary mt-8 mb-3">Next Steps After Your Due Date</h3>
        <ol class="list-decimal list-inside space-y-2 text-sm leading-relaxed">
          <li>Schedule your first prenatal appointment (typically 8–10 weeks gestation).</li>
          <li>Start a prenatal vitamin with folic acid (400–800 mcg) if not already taking one.</li>
          <li>Track your pregnancy week-by-week using our <a href="/fertility-calendar" class="text-brand-rose underline hover:no-underline">fertility calendar</a> for symptom insights and appointment reminders.</li>
          <li>Use the <a href="/pregnancy-test-calculator" class="text-brand-rose underline hover:no-underline">pregnancy test calculator</a> to know the earliest reliable testing window if you're still confirming pregnancy.</li>
          <li>Discuss screening options (NIPT, quad screen, anatomy scan) with your provider based on your dates.</li>
        </ol>
      </article>
    </section>

    <!-- FAQ Section -->
    <section class="mt-16 md:mt-24 max-w-3xl mx-auto space-y-10" aria-labelledby="faq-heading">
      <h2 id="faq-heading" class="text-2xl md:text-3xl font-semibold text-primary text-center mb-10">
        Frequently Asked Questions
      </h2>

      <div class="space-y-3" id="faq-accordion">
        {faqSchema.mainEntity.map((item, index) => (
          <div class="card-container bg-canvas-soft-2 overflow-hidden">
            <button
              type="button"
              class="faq-toggle w-full flex items-center justify-between text-left gap-4 cursor-pointer"
              data-index={index}
              aria-expanded="false"
            >
              <span class="text-[13px] font-semibold text-primary">{item.name}</span>
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4 shrink-0 text-secondary transition-transform duration-300 faq-icon" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
              </svg>
            </button>
            <div class="faq-answer hidden overflow-hidden transition-all duration-300">
              <p class="text-xs text-secondary leading-relaxed pt-3 pb-1 border-t border-hairline mt-3">
                {item.acceptedAnswer.text}
              </p>
            </div>
          </div>
        ))}
      </div>
    </section>

  </div>
</Layout>

<script>
  import { addDays, subDays, format, differenceInDays, parseISO, isAfter } from 'date-fns';

  // Value sync
  const cycleInput = document.getElementById('due-cycle') as HTMLInputElement;
  const cycleVal = document.getElementById('due-cycle-val');
  if (cycleInput && cycleVal) {
    cycleInput.addEventListener('input', () => {
      cycleVal.textContent = cycleInput.value;
    });
  }

  // Set today's date in base date input
  const baseDateInput = document.getElementById('base-date') as HTMLInputElement;
  if (baseDateInput) {
    baseDateInput.value = format(new Date(), 'yyyy-MM-dd');
  }

  // Tabs toggle
  const tabLmp = document.getElementById('due-tab-lmp');
  const tabConception = document.getElementById('due-tab-conception');
  const tabIvf = document.getElementById('due-tab-ivf');
  
  const methodInput = document.getElementById('due-method') as HTMLInputElement;
  const cycleWrapper = document.getElementById('due-cycle-wrapper');
  const ivfWrapper = document.getElementById('due-ivf-wrapper');
  const dateLabel = document.getElementById('date-input-label');

  const activeClass = 'border-brand-gold text-primary';
  const inactiveClass = 'border-transparent text-secondary hover:text-primary';

  function deactivateTab(tab: HTMLElement | null) {
    if (!tab) return;
    tab.className = tab.className.replace(activeClass, inactiveClass);
    tab.setAttribute('aria-selected', 'false');
    tab.setAttribute('tabindex', '-1');
  }

  function activateTab(tab: HTMLElement | null) {
    if (!tab) return;
    tab.className = tab.className.replace(inactiveClass, activeClass);
    tab.setAttribute('aria-selected', 'true');
    tab.removeAttribute('tabindex');
  }

  tabLmp?.addEventListener('click', () => {
    methodInput.value = 'lmp';
    activateTab(tabLmp);
    deactivateTab(tabConception);
    deactivateTab(tabIvf);

    cycleWrapper?.classList.remove('hidden');
    ivfWrapper?.classList.add('hidden');
    if (dateLabel) dateLabel.textContent = 'First Day of Last Period';
  });

  tabConception?.addEventListener('click', () => {
    methodInput.value = 'conception';
    activateTab(tabConception);
    deactivateTab(tabLmp);
    deactivateTab(tabIvf);

    cycleWrapper?.classList.add('hidden');
    ivfWrapper?.classList.add('hidden');
    if (dateLabel) dateLabel.textContent = 'Estimated Conception Date';
  });

  tabIvf?.addEventListener('click', () => {
    methodInput.value = 'ivf';
    activateTab(tabIvf);
    deactivateTab(tabLmp);
    deactivateTab(tabConception);

    cycleWrapper?.classList.add('hidden');
    ivfWrapper?.classList.remove('hidden');
    if (dateLabel) dateLabel.textContent = 'IVF Embryo Transfer Date';
  });

  // Calculate Form
  const form = document.getElementById('due-calculator-form');
  const resultsDiv = document.getElementById('due-results');
  
  const resultDue = document.getElementById('result-due-date');
  const resultLeft = document.getElementById('result-days-left');
  const resultAge = document.getElementById('result-gestational-age');
  const resultTrimester = document.getElementById('result-trimester');

  const progressTri1 = document.getElementById('bar-tri-1');
  const progressTri2 = document.getElementById('bar-tri-2');
  const progressTri3 = document.getElementById('bar-tri-3');

  const msConception = document.getElementById('milestone-conception');
  const msHeartbeat = document.getElementById('milestone-heartbeat');
  const msKick = document.getElementById('milestone-kick');
  const msViability = document.getElementById('milestone-viability');
  const msTerm = document.getElementById('milestone-term');

  form?.addEventListener('submit', (e) => {
    e.preventDefault();

    const rawDate = baseDateInput.value;
    const dateParsed = parseISO(rawDate);
    const method = methodInput.value;

    let dueDate: Date;
    let lmpEquivalent: Date;

    if (method === 'lmp') {
      const cycle = Number(cycleInput.value);
      // Adjustment for cycle lengths differing from standard 28
      dueDate = addDays(dateParsed, 280 + (cycle - 28));
      lmpEquivalent = dateParsed;
    } else if (method === 'conception') {
      dueDate = addDays(dateParsed, 266);
      lmpEquivalent = subDays(dateParsed, 14);
    } else {
      const ivfType = (document.getElementById('ivf-type') as HTMLSelectElement).value;
      if (ivfType === '3day') {
        dueDate = addDays(dateParsed, 263);
        lmpEquivalent = subDays(dateParsed, 17);
      } else {
        dueDate = addDays(dateParsed, 261);
        lmpEquivalent = subDays(dateParsed, 19);
      }
    }

    const today = new Date();
    
    // Gestational age in days
    let ageInDays = differenceInDays(today, lmpEquivalent);
    if (ageInDays < 0) ageInDays = 0;
    if (ageInDays > 280) ageInDays = 280;

    const weeks = Math.floor(ageInDays / 7);
    const days = ageInDays % 7;

    const daysLeft = differenceInDays(dueDate, today);

    // Milestones
    const conceptionDate = addDays(lmpEquivalent, 14);
    const heartbeatDate = addDays(lmpEquivalent, 42); // 6 weeks
    const kickDate = addDays(lmpEquivalent, 126);      // 18 weeks
    const viabilityDate = addDays(lmpEquivalent, 168); // 24 weeks
    const termDate = addDays(lmpEquivalent, 259);      // 37 weeks

    // Display values
    if (resultDue) resultDue.textContent = format(dueDate, 'MMMM dd, yyyy');
    if (resultLeft) {
      resultLeft.textContent = daysLeft > 0 
        ? `${daysLeft} days until your estimated delivery date.`
        : 'Your estimated delivery date is in the past.';
    }
    if (resultAge) resultAge.textContent = `${weeks} Weeks, ${days} Days`;
    
    // Trimester
    let trimesterName = 'First Trimester';
    if (weeks >= 14 && weeks < 28) {
      trimesterName = 'Second Trimester';
    } else if (weeks >= 28) {
      trimesterName = 'Third Trimester';
    }
    if (resultTrimester) resultTrimester.textContent = trimesterName;

    // Progress Bars width
    const totalPercentage = (ageInDays / 280) * 100;
    
    // Tri 1 caps at 98 days (14 weeks / 40%)
    const tri1Days = Math.min(ageInDays, 98);
    const tri1Percent = (tri1Days / 98) * 35; // 35% of total scale
    if (progressTri1) progressTri1.style.width = `${tri1Percent || 5}%`;

    // Tri 2 caps at 98 days (from 14 to 28 weeks / 40%)
    const tri2Days = Math.min(Math.max(ageInDays - 98, 0), 98);
    const tri2Percent = (tri2Days / 98) * 35; // 35% of total scale
    if (progressTri2) progressTri2.style.width = `${tri2Percent || 5}%`;

    // Tri 3 caps at 84 days (from 28 to 40 weeks / 30%)
    const tri3Days = Math.min(Math.max(ageInDays - 196, 0), 84);
    const tri3Percent = (tri3Days / 84) * 30; // 30% of total scale
    if (progressTri3) progressTri3.style.width = `${tri3Percent || 5}%`;

    // Milestones Dates
    if (msConception) msConception.textContent = format(conceptionDate, 'MMMM dd, yyyy');
    if (msHeartbeat) msHeartbeat.textContent = format(heartbeatDate, 'MMMM dd, yyyy');
    if (msKick) msKick.textContent = format(kickDate, 'MMMM dd, yyyy');
    if (msViability) msViability.textContent = format(viabilityDate, 'MMMM dd, yyyy');
    if (msTerm) msTerm.textContent = format(termDate, 'MMMM dd, yyyy');

    resultsDiv?.classList.remove('hidden');

    setTimeout(() => {
      resultsDiv?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }, 100);
  });

  // FAQ Accordion Toggle
  document.querySelectorAll('.faq-toggle').forEach((btn) => {
    btn.addEventListener('click', () => {
      const answer = btn.nextElementSibling;
      const icon = btn.querySelector('.faq-icon');
      const isOpen = !answer.classList.contains('hidden');

      // Close all other answers
      document.querySelectorAll('.faq-answer').forEach((el) => el.classList.add('hidden'));
      document.querySelectorAll('.faq-icon').forEach((el) => el.style.transform = 'rotate(0deg)');
      document.querySelectorAll('.faq-toggle').forEach((el) => el.setAttribute('aria-expanded', 'false'));

      if (!isOpen) {
        answer.classList.remove('hidden');
        if (icon) icon.style.transform = 'rotate(180deg)';
        btn.setAttribute('aria-expanded', 'true');
      }
    });
  });
</script>
