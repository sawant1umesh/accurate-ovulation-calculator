---
import Layout from '../layouts/Layout.astro';

const pageTitle = "About Us - Accurate Ovulation Calculator | Free Private Fertility Tools";
const pageDescription = "Learn about Accurate Ovulation Calculator's mission to provide free, private, clinically-informed fertility calculators. Evidence-based algorithms, 100% client-side processing, no data collection.";

const aboutSchema = {
  "@context": "https://schema.org",
  "@type": "AboutPage",
  "name": "About Accurate Ovulation Calculator",
  "description": pageDescription,
  "url": "https://accurateovulationcalculator.com/about",
  "mainEntity": {
    "@type": "Organization",
    "name": "Accurate Ovulation Calculator",
    "url": "https://accurateovulationcalculator.com",
    "description": "Free, private, and clinically-informed fertility calculators for educational use."
  }
};

const calculators = [
  {
    title: "Ovulation Calculator",
    description: "Estimates your fertile window, ovulation day, and implantation period based on your cycle length and luteal phase — with support for irregular cycles.",
    href: "/ovulation-calculator",
    color: "brand-rose",
    bgColor: "brand-blush",
    borderColor: "brand-rose-border",
  },
  {
    title: "Fertility Calendar",
    description: "Visualizes your cycle data on an interactive 2-month calendar with color-coded fertile windows, ovulation markers, and calendar export options.",
    href: "/fertility-calendar",
    color: "brand-sage",
    bgColor: "brand-sage-light",
    borderColor: "brand-sage",
  },
  {
    title: "Due Date Calculator",
    description: "Calculates your estimated due date and trimester milestones from your last menstrual period, conception date, or IVF transfer date.",
    href: "/due-date-calculator",
    color: "brand-gold",
    bgColor: "brand-gold/10",
    borderColor: "brand-gold",
  },
  {
    title: "Pregnancy Test Calculator",
    description: "Determines the optimal date to take a pregnancy test and compares accuracy windows for blood, early urine, and standard over-the-counter tests.",
    href: "/pregnancy-test-calculator",
    color: "brand-rose",
    bgColor: "brand-blush",
    borderColor: "brand-rose-border",
  },
];

const trustPoints = [
  {
    title: "Evidence-Based Methods",
    description: "Our calculators use standardized reproductive metrics — including the Ogino-Knaus method and customizable luteal phase lengths — drawing from established medical literature.",
    icon: "chart",
  },
  {
    title: "Educational Focus",
    description: "Every tool includes contextual explanations of the science behind the calculations, helping you understand your body — not just the numbers.",
    icon: "book",
  },
  {
    title: "Transparent Limitations",
    description: "We clearly state that all results are statistical estimates. We never overstate accuracy or suggest our tools replace professional medical advice.",
    icon: "info",
  },
  {
    title: "Free & Accessible",
    description: "All calculators are completely free to use. There are no paywalls, no premium tiers, and no hidden charges — accessible to everyone with an internet connection.",
    icon: "heart",
  },
];
---

<Layout title={pageTitle} description={pageDescription} schema={aboutSchema}>

  <!-- Page Header -->
  <section class="relative overflow-hidden bg-canvas-soft">
    <div class="mx-auto max-w-7xl px-5 sm:px-6 lg:px-8 py-16 md:py-24 lg:py-28">
      <div class="text-center max-w-3xl mx-auto">
        <!-- Tagline Badge -->
        <span class="inline-flex items-center gap-1.5 text-[11px] font-mono font-semibold tracking-widest text-brand-rose uppercase mb-7 px-4 py-2 rounded-full bg-brand-blush border border-brand-rose-border/50 backdrop-blur-sm">
          <span class="w-1.5 h-1.5 rounded-full bg-brand-rose animate-pulse"></span>
          About Accurate Ovulation
        </span>

        <h1 class="text-[2.25rem] md:text-4xl lg:text-[2.75rem] font-semibold tracking-tight text-primary leading-[1.15]">
          Empowering Informed Decisions About Your Reproductive Health
        </h1>

        <p class="mt-7 text-base md:text-lg text-secondary leading-[1.7] max-w-[38rem] mx-auto">
          Accurate Ovulation provides free, private, and clinically-informed fertility calculators designed to help you understand your cycle — with the clarity and accuracy you deserve.
        </p>
      </div>
    </div>
  </section>

  <!-- Our Mission Section -->
  <section class="bg-canvas py-16 md:py-24">
    <div class="mx-auto max-w-7xl px-5 sm:px-6 lg:px-8">
      <div class="max-w-3xl mx-auto">
        <div class="text-center mb-10 md:mb-12">
          <span class="text-[11px] font-mono font-semibold tracking-widest text-brand-rose uppercase">
            Our Mission
          </span>
          <h2 class="text-2xl md:text-3xl font-semibold tracking-tight text-primary mt-3 mb-4">
            Accurate, Accessible & Private Fertility Education
          </h2>
        </div>

        <div class="card-container">
          <div class="space-y-5 text-[15px] text-secondary leading-[1.8]">
            <p>
              Accurate Ovulation was created with a simple mission: to provide women and couples with <strong class="text-primary font-medium">reliable, easy-to-understand fertility tools</strong> — without compromising on privacy or scientific integrity.
            </p>
            <p>
              We believe that understanding your menstrual cycle shouldn't require expensive apps, invasive data collection, or a medical degree. Our calculators distill established reproductive science into clear, actionable insights — while being completely transparent about the limitations of any estimation tool.
            </p>
            <p>
              Every tool we build adheres to three principles: <strong class="text-primary font-medium">clinical accuracy</strong>, <strong class="text-primary font-medium">complete privacy</strong>, and <strong class="text-primary font-medium">responsible education</strong>. We don't sell your data, we don't make medical claims, and we always encourage consulting qualified healthcare providers for personalized guidance.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Our Approach Section -->
  <section class="bg-canvas-soft py-16 md:py-24">
    <div class="mx-auto max-w-7xl px-5 sm:px-6 lg:px-8">
      <div class="max-w-3xl mx-auto">
        <div class="text-center mb-10 md:mb-12">
          <span class="text-[11px] font-mono font-semibold tracking-widest text-brand-sage uppercase">
            Our Approach
          </span>
          <h2 class="text-2xl md:text-3xl font-semibold tracking-tight text-primary mt-3 mb-4">
            How We Build Our Calculators
          </h2>
        </div>

        <div class="space-y-5">
          <!-- Approach Item 1 -->
          <div class="card-container flex items-start gap-4">
            <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-brand-blush border border-brand-rose-border text-brand-rose">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9.75 3.104v5.714a2.25 2.25 0 01-.659 1.591L5 14.5M9.75 3.104c-.251.023-.501.05-.75.082m.75-.082a24.301 24.301 0 014.5 0m0 0v5.714c0 .597.237 1.17.659 1.591L19.8 15.3M14.25 3.104c.251.023.501.05.75.082M19.8 15.3l-1.57.393A9.065 9.065 0 0112 15a9.065 9.065 0 00-6.23.693L5 14.5m14.8.8l1.402 1.402c1.232 1.232.65 3.318-1.067 3.611A48.309 48.309 0 0112 21c-2.773 0-5.491-.235-8.135-.687-1.718-.293-2.3-2.379-1.067-3.61L5 14.5" />
              </svg>
            </span>
            <div>
              <h3 class="text-base font-semibold text-primary mb-1">Evidence-Based Algorithms</h3>
              <p class="text-sm text-secondary leading-relaxed">
                Our calculations are rooted in standardized reproductive metrics. We reference established methods — including the Ogino-Knaus method for cycle estimation, customizable luteal phase durations, and clinically-documented implantation windows — to generate our projections.
              </p>
            </div>
          </div>

          <!-- Approach Item 2 -->
          <div class="card-container flex items-start gap-4">
            <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-brand-sage-light border border-brand-sage text-brand-sage">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" />
              </svg>
            </span>
            <div>
              <h3 class="text-base font-semibold text-primary mb-1">Client-Side Processing Only</h3>
              <p class="text-sm text-secondary leading-relaxed">
                Every calculation runs entirely in your browser. No cycle data, dates, or personal information is ever transmitted to our servers, stored in a database, or shared with third parties. Your fertility data stays on your device — period.
              </p>
            </div>
          </div>

          <!-- Approach Item 3 -->
          <div class="card-container flex items-start gap-4">
            <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-brand-lavender border border-brand-lavender-border text-primary">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4.26 10.147a60.436 60.436 0 00-.491 6.347A48.627 48.627 0 0112 20.904a48.627 48.627 0 018.232-4.41 60.46 60.46 0 00-.491-6.347m-15.482 0a50.57 50.57 0 00-2.658-.813A59.905 59.905 0 0112 3.493a59.902 59.902 0 0110.399 5.84c-.896.248-1.783.52-2.658.814m-15.482 0A50.697 50.697 0 0112 13.489a50.702 50.702 0 017.74-3.342M6.75 15a.75.75 0 100-1.5.75.75 0 000 1.5zm0 0v-3.675A55.378 55.378 0 0112 8.443m-7.007 11.55A5.981 5.981 0 006.75 15.75v-1.5" />
              </svg>
            </span>
            <div>
              <h3 class="text-base font-semibold text-primary mb-1">Educational Context in Every Tool</h3>
              <p class="text-sm text-secondary leading-relaxed">
                We don't just display numbers. Each calculator includes contextual explanations — from how the fertile window is determined to what cervical mucus patterns mean — so you understand the science behind every result.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Our Calculators Section -->
  <section class="bg-canvas py-16 md:py-24">
    <div class="mx-auto max-w-7xl px-5 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-12 md:mb-14">
        <span class="text-[11px] font-mono font-semibold tracking-widest text-brand-gold uppercase">
          Our Calculators
        </span>
        <h2 class="text-2xl md:text-3xl font-semibold tracking-tight text-primary mt-3 mb-4">
          Tools We Offer
        </h2>
        <p class="text-sm text-secondary leading-relaxed max-w-xl mx-auto">
          Each calculator is built for accuracy, accessibility, and privacy. Choose the tool that best fits your current needs.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-5 max-w-4xl mx-auto">
        {calculators.map((calc) => (
          <a
            href={calc.href}
            class="card-container group hover:-translate-y-0.5 hover:shadow-lg transition-all duration-300 flex flex-col h-full"
          >
            <div class="flex items-start gap-4">
              <span class={`flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-${calc.bgColor} border border-${calc.borderColor} text-${calc.color} transition-all duration-300 group-hover:scale-105`}>
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 15.75V18m-7.5-6.75h.008v.008H8.25v-.008zm0 2.25h.008v.008H8.25v-.008zm0 2.25h.008v.008H8.25v-.008zm0 2.25h.008v.008H8.25v-.008zm2.498-6.75h.007v.008h-.007v-.008zm0 2.25h.007v.008h-.007v-.008zm0 2.25h.007v.008h-.007v-.008zm0 2.25h.007v.008h-.007v-.008zm2.504-6.75h.008v.008h-.008v-.008zm0 2.25h.008v.008h-.008v-.008zm0 2.25h.008v.008h-.008v-.008zm0 2.25h.008v.008h-.008v-.008zm2.498-6.75h.008v.008h-.008v-.008zm0 2.25h.008v.008h-.008v-.008zM8.25 6h7.5v2.25h-7.5V6zM12 2.25c-1.892 0-3.758.11-5.593.322C5.307 2.7 4.5 3.65 4.5 4.757V19.5a2.25 2.25 0 002.25 2.25h10.5a2.25 2.25 0 002.25-2.25V4.757c0-1.108-.806-2.057-1.907-2.185A48.507 48.507 0 0012 2.25z" />
                </svg>
              </span>
              <div class="flex-1 min-w-0">
                <h3 class="text-base font-semibold text-primary group-hover:text-brand-rose transition-colors duration-300">
                  {calc.title}
                </h3>
                <p class="text-[13px] text-secondary mt-2 leading-relaxed">
                  {calc.description}
                </p>
                <div class="mt-4 pt-3 border-t border-hairline flex items-center text-xs font-medium text-brand-rose">
                  <span>Try This Calculator</span>
                  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-3.5 h-3.5 ml-1.5 transition-transform duration-300 group-hover:translate-x-1">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
                  </svg>
                </div>
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Why Trust Us Section -->
  <section class="bg-canvas-soft py-16 md:py-24">
    <div class="mx-auto max-w-7xl px-5 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-12 md:mb-14">
        <span class="text-[11px] font-mono font-semibold tracking-widest text-brand-sage uppercase">
          Why Trust Us
        </span>
        <h2 class="text-2xl md:text-3xl font-semibold tracking-tight text-primary mt-3 mb-4">
          Built on Integrity & Transparency
        </h2>
        <p class="text-sm text-secondary leading-relaxed max-w-xl mx-auto">
          We earn your trust through responsible content, honest limitations, and unwavering respect for your privacy.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-5 max-w-4xl mx-auto">
        {trustPoints.map((point) => (
          <div class="card-container">
            <div class="flex items-start gap-4">
              <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-brand-sage-light border border-brand-sage text-brand-sage">
                {point.icon === 'chart' && (
                  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 3v11.25A2.25 2.25 0 006 16.5h2.25M3.75 3h-1.5m1.5 0h16.5m0 0h1.5m-1.5 0v11.25A2.25 2.25 0 0118 16.5h-2.25m-7.5 0h7.5m-7.5 0l-1 3m8.5-3l1 3m0 0l.5 1.5m-.5-1.5h-9.5m0 0l-.5 1.5m.75-9l3-3 2.148 2.148A12.061 12.061 0 0116.5 7.605" />
                  </svg>
                )}
                {point.icon === 'book' && (
                  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 016-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0018 18a8.967 8.967 0 00-6 2.292m0-14.25v14.25" />
                  </svg>
                )}
                {point.icon === 'info' && (
                  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M11.25 11.25l.041-.02a.75.75 0 011.063.852l-.708 2.836a.75.75 0 001.063.853l.041-.021M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-9-3.75h.008v.008H12V8.25z" />
                  </svg>
                )}
                {point.icon === 'heart' && (
                  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z" />
                  </svg>
                )}
              </span>
              <div>
                <h3 class="text-base font-semibold text-primary mb-1.5">{point.title}</h3>
                <p class="text-[13px] text-secondary leading-relaxed">
                  {point.description}
                </p>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Privacy Commitment Section -->
  <section class="bg-canvas py-16 md:py-24">
    <div class="mx-auto max-w-7xl px-5 sm:px-6 lg:px-8">
      <div class="max-w-3xl mx-auto">
        <div class="text-center mb-10 md:mb-12">
          <span class="text-[11px] font-mono font-semibold tracking-widest text-brand-rose uppercase">
            Privacy Commitment
          </span>
          <h2 class="text-2xl md:text-3xl font-semibold tracking-tight text-primary mt-3 mb-4">
            Your Data Never Leaves Your Device
          </h2>
        </div>

        <div class="card-container">
          <div class="flex items-center gap-3 mb-6 pb-5 border-b border-hairline">
            <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-brand-sage-light text-brand-sage">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 10-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 002.25-2.25v-6.75a2.25 2.25 0 00-2.25-2.25H6.75a2.25 2.25 0 00-2.25 2.25v6.75a2.25 2.25 0 002.25 2.25z" />
              </svg>
            </span>
            <div>
              <h3 class="text-base font-semibold text-primary">100% Client-Side Processing</h3>
              <p class="text-xs text-secondary mt-0.5">Zero data collection. Zero server storage. Zero third-party sharing.</p>
            </div>
          </div>

          <div class="space-y-4 text-[15px] text-secondary leading-[1.8]">
            <p>
              Privacy isn't a feature we market — it's the foundation of how we build. Every calculation on Accurate Ovulation runs entirely within your browser. We have <strong class="text-primary font-medium">no back-end servers processing your data</strong>, no analytics tracking your cycle inputs, and no accounts storing your personal health information.
            </p>
            <p>
              We don't use cookies to track your fertility data, we don't require user registration, and we will never monetize your health information. When you close your browser tab, your data is gone — unless you've explicitly chosen to use a local browser storage feature.
            </p>
          </div>

          <div class="mt-6 pt-5 border-t border-hairline">
            <div class="flex items-center gap-2">
              <span class="inline-flex h-2 w-2 rounded-full bg-brand-sage animate-pulse"></span>
              <span class="text-xs font-mono text-secondary">
                100% Privacy: Local Processing Only
              </span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Medical Disclaimer Section -->
  <section class="bg-canvas-soft py-16 md:py-24">
    <div class="mx-auto max-w-7xl px-5 sm:px-6 lg:px-8">
      <div class="max-w-3xl mx-auto">
        <div class="text-center mb-10 md:mb-12">
          <span class="text-[11px] font-mono font-semibold tracking-widest text-brand-gold uppercase">
            Important Notice
          </span>
          <h2 class="text-2xl md:text-3xl font-semibold tracking-tight text-primary mt-3 mb-4">
            Results Are Estimates, Not Medical Advice
          </h2>
        </div>

        <div class="rounded-xl bg-canvas p-6 md:p-8 border border-hairline shadow-md">
          <div class="flex items-start gap-4">
            <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-brand-blush text-brand-rose mt-0.5">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z" />
              </svg>
            </span>
            <div class="space-y-4 text-[15px] text-secondary leading-[1.8]">
              <p>
                All calculations, predictions, and educational content provided by Accurate Ovulation are for <strong class="text-primary font-medium">informational and educational purposes only</strong>. They are based on statistical averages and standardized reproductive metrics, which can vary widely between individuals.
              </p>
              <p>
                Our tools are <strong class="text-primary font-medium">not intended as a substitute</strong> for professional medical advice, clinical diagnosis, or medical treatment. They must <strong class="text-primary font-medium">never be used as a method of contraception or birth control</strong>.
              </p>
              <p>
                Always consult with a qualified, licensed healthcare provider, gynecologist, or fertility specialist regarding any questions or concerns about your cycle, pregnancy planning, or reproductive health.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Stay Connected Section -->
  <section class="bg-canvas py-16 md:py-24">
    <div class="mx-auto max-w-7xl px-5 sm:px-6 lg:px-8">
      <div class="max-w-3xl mx-auto">
        <div class="text-center mb-10 md:mb-12">
          <span class="text-[11px] font-mono font-semibold tracking-widest text-brand-rose uppercase">
            Stay Connected
          </span>
          <h2 class="text-2xl md:text-3xl font-semibold tracking-tight text-primary mt-3 mb-4">
            We'd Love to Hear From You
          </h2>
          <p class="text-sm text-secondary leading-relaxed max-w-xl mx-auto">
            Have questions or suggestions about Accurate Ovulation Calculator? We're always happy to hear from our users.
          </p>
        </div>

        <div class="card-container text-center">
          <div class="flex justify-center mb-4">
            <span class="flex h-12 w-12 items-center justify-center rounded-full bg-brand-blush text-brand-rose">
