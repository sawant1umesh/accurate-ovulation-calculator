---
import Layout from '../layouts/Layout.astro';

const pageTitle = "404 - Page Not Found | Accurate Ovulation Calculator";
const pageDescription = "The page you are looking for could not be found.";

const popularTools = [
  {
    title: "Ovulation Calculator",
    description: "Calculate your fertile window and ovulation day with clinical precision.",
    href: "/",
    color: "brand-rose",
    bgColor: "brand-blush",
    borderColor: "brand-rose-border",
  },
  {
    title: "Fertility Calendar",
    description: "Visual 2-month calendar with daily fertility insights and ICS export.",
    href: "/fertility-calendar",
    color: "brand-sage",
    bgColor: "brand-sage-light",
    borderColor: "brand-sage",
  },
  {
    title: "Due Date Calculator",
    description: "Calculate estimated due date from LMP, conception, or IVF transfer.",
    href: "/due-date-calculator",
    color: "brand-gold",
    bgColor: "brand-gold/10",
    borderColor: "brand-gold",
  },
  {
    title: "Pregnancy Test Calculator",
    description: "Find the earliest accurate test date for all test types.",
    href: "/pregnancy-test-calculator",
    color: "brand-rose",
    bgColor: "brand-blush",
    borderColor: "brand-rose-border",
  },
];
---

<Layout title={pageTitle} description={pageDescription}>
  <meta name="robots" content="noindex, follow" slot="head" />

  <section class="relative overflow-hidden bg-canvas-soft">
    <div class="mx-auto max-w-7xl px-5 sm:px-6 lg:px-8 py-24 md:py-36 lg:py-44">
      <div class="text-center max-w-3xl mx-auto">
        <!-- Large 404 Number -->
        <span class="block text-[6rem] md:text-[8rem] lg:text-[10rem] font-bold text-brand-rose/20 leading-none select-none">
          404
        </span>

        <!-- Main Heading -->
        <h1 class="text-3xl md:text-4xl lg:text-5xl font-semibold tracking-tight text-primary -mt-6 md:-mt-10">
          Page Not Found
        </h1>

        <!-- Friendly Message -->
        <p class="mt-6 text-base md:text-lg text-secondary leading-relaxed max-w-xl mx-auto">
          Sorry, the page you're looking for doesn't exist or may have been moved. Let us help you find what you need.
        </p>

        <!-- Primary Button -->
        <div class="mt-10 flex justify-center">
          <a href="/" class="btn-primary h-12 px-10 text-[15px] font-semibold shadow-lg hover:shadow-xl transition-all duration-300">
            Back to Homepage
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Popular Tools Section -->
  <section class="bg-canvas py-16 md:py-24" aria-labelledby="popular-tools-heading">
    <div class="mx-auto max-w-7xl px-5 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-10">
        <span class="text-[11px] font-mono font-semibold tracking-widest text-brand-sage uppercase">
          Explore Our Tools
        </span>
        <h2 id="popular-tools-heading" class="text-xl md:text-2xl font-semibold tracking-tight text-primary mt-2 mb-3">
          Popular Tools
        </h2>
        <p class="text-sm text-secondary leading-relaxed max-w-xl mx-auto">
          Get back on track with one of our fertility calculators.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 max-w-5xl mx-auto">
        {popularTools.map((tool) => (
          <a
            href={tool.href}
            class="card-container group hover:shadow-md transition-all duration-200 p-5"
          >
            <div class="flex items-start gap-3">
              <span class={`flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-${tool.bgColor} border border-${tool.borderColor} text-${tool.color} transition-all duration-200 group-hover:scale-105`}>
                {tool.title === "Ovulation Calculator" && (
                  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" />
                  </svg>
                )}
                {tool.title === "Fertility Calendar" && (
                  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6A2.25 2.25 0 016 3.75h2.25A2.25 2.25 0 0110.5 6v2.25a2.25 2.25 0 01-2.25 2.25H6a2.25 2.25 0 01-2.25-2.25V6zM3.75 15.75A2.25 2.25 0 016 13.5h2.25a2.25 2.25 0 012.25 2.25V18a2.25 2.25 0 01-2.25 2.25H6A2.25 2.25 0 013.75 18v-2.25zM13.5 6a2.25 2.25 0 012.25-2.25H18A2.25 2.25 0 0120.25 6v2.25A2.25 2.25 0 0118 10.5h-2.25a2.25 2.25 0 01-2.25-2.25V6zM13.5 15.75a2.25 2.25 0 012.25-2.25H18a2.25 2.25 0 012.25 2.25V18A2.25 2.25 0 0118 20.25h-2.25A2.25 2.25 0 0113.5 18v-2.25z" />
                  </svg>
                )}
                {tool.title === "Due Date Calculator" && (
                  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" />
                  </svg>
                )}
                {tool.title === "Pregnancy Test Calculator" && (
                  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9.75 3.104v5.714a2.25 2.25 0 01-.659 1.591L5 14.5M9.75 3.104c-.251.023-.501.05-.75.082m.75-.082a24.301 24.301 0 014.5 0m0 0v5.714c0 .597.237 1.17.659 1.591L19.8 15.3M14.25 3.104c.251.023.501.05.75.082M19.8 15.3l-1.57.393A9.065 9.065 0 0112 15a9.065 9.065 0 00-6.23.693L5 14.5m14.8.8l1.402 1.402c1.232 1.232.65 3.318-1.067 3.611A48.309 48.309 0 0112 21c-2.773 0-5.491-.235-8.135-.687-1.718-.293-2.3-2.379-1.067-3.61L5 14.5" />
                  </svg>
                )}
              </span>
              <div class="flex-1 min-w-0">
                <h3 class="text-sm font-semibold text-primary group-hover:text-brand-rose transition-colors duration-200">
                  {tool.title}
                </h3>
                <p class="text-[12px] text-secondary mt-1 leading-relaxed">
                  {tool.description}
                </p>
                <div class="mt-3 pt-3 border-t border-hairline">
                  <span class="inline-flex items-center text-xs font-medium text-brand-rose hover:text-primary transition-colors">
                    Open Tool
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-3 h-3 ml-1 transition-transform duration-200 group-hover:translate-x-1">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
                    </svg>
                  </span>
                </div>
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Need Help Section -->
  <section class="bg-canvas-soft-2 py-12 md:py-16">
    <div class="mx-auto max-w-4xl px-5 sm:px-6 lg:px-8">
      <div class="card-container bg-canvas text-center">
        <div class="flex justify-center mb-4">
          <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-brand-blush border border-brand-rose-border text-brand-rose">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9.879 7.519c1.171-1.025 3.071-1.025 4.242 0 1.172 1.025 1.172 2.687 0 3.712-.203.179-.43.326-.67.442-.745.361-1.45.999-1.45 1.827v.75M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-9 5.25h.008v.008H12v-.008z" />
            </svg>
          </span>
        </div>
        <h3 class="text-sm font-semibold text-primary mb-2">Need Help?</h3>
        <p class="text-xs text-secondary leading-relaxed max-w-md mx-auto mb-4">
          If you believe this page should exist, please let us know.
        </p>
        <a href="mailto:hello@accurateovulationcalculator.com" class="btn-secondary h-10 px-6 text-sm font-medium">
          Contact Us
        </a>
      </div>
    </div>
  </section>
</Layout>
