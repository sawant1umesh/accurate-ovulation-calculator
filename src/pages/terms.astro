---
import Layout from '../layouts/Layout.astro';

const pageTitle = "Terms of Use - Accurate Ovulation Calculator | Legal Terms & Conditions";
const pageDescription = "Review our Terms of Use covering acceptable use, medical disclaimers, calculator accuracy limitations, intellectual property, and limitation of liability. Free fertility tools for educational purposes only.";

