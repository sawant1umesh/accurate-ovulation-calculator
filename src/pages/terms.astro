  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "Terms of Use - Accurate Ovulation Calculator",
  "description": pageDescription,
  "url": "https://accurateovulationcalculator.com/terms",
  "mainEntity": {
    "@type": "Organization",
    "name": "Accurate Ovulation Calculator",
    "url": "https://accurateovulationcalculator.com"
  }
};

const lastUpdated = "July 19, 2026";
