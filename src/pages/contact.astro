---
import Layout from '../layouts/Layout.astro';

const pageTitle = "Contact Us - Accurate Ovulation Calculator | Feedback & Support";
const pageDescription = "Contact the Accurate Ovulation team for feedback, bug reports, or general questions about our fertility calculators. We aim to respond within 1-2 business days.";

const contactSchema = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  "name": "Contact Accurate Ovulation Calculator",
  "description": pageDescription,
  "url": "https://accurateovulationcalculator.com/contact",
  "mainEntity": {
    "@type": "Organization",
    "name": "Accurate Ovulation Calculator",
    "url": "https://accurateovulationcalculator.com"
  }
};
---

<Layout title={pageTitle} description={pageDescription} schema={contactSchema}>

  <!-- Page Header -->
  <section class="relative overflow-hidden bg-canvas-soft">
    <div class="mx-auto max-w-7xl px-5 sm:px-6 lg:px-8 py-16 md:py-24 lg:py-28">
      <div class="text-center max-w-3xl mx-auto">
        <!-- Tagline Badge -->
        <span class="inline-flex items-center gap-1.5 text-[11px] font-mono font-semibold tracking-widest text-brand-rose uppercase mb-7 px-4 py-2 rounded-full bg-brand-blush border border-brand-rose-border/50 backdrop-blur-sm">
          <span class="w-1.5 h-1.5 rounded-full bg-brand-rose animate-pulse"></span>
          Get In Touch
        </span>

        <h1 class="text-[2.25rem] md:text-4xl lg:text-[2.75rem] font-semibold tracking-tight text-primary leading-[1.15]">
          We'd Love to Hear From You
        </h1>

        <p class="mt-7 text-base md:text-lg text-secondary leading-[1.7] max-w-[38rem] mx-auto">
          Whether you have feedback on our calculators, want to report an issue, or have a general question — we welcome your input and appreciate you reaching out.
        </p>
      </div>
    </div>
  </section>

  <!-- Contact Details Section -->
  <section class="bg-canvas py-16 md:py-24">
    <div class="mx-auto max-w-7xl px-5 sm:px-6 lg:px-8">
      <div class="max-w-3xl mx-auto">
        <div class="text-center mb-10 md:mb-12">
          <span class="text-[11px] font-mono font-semibold tracking-widest text-brand-sage uppercase">
            Contact Information
          </span>
          <h2 class="text-2xl md:text-3xl font-semibold tracking-tight text-primary mt-3 mb-4">
            How to Reach Us
          </h2>
          <p class="text-sm text-secondary leading-relaxed max-w-xl mx-auto">
            We're currently preparing for launch and will have official contact channels available soon. In the meantime, here's what to expect.
          </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
          <!-- Support Email Card -->
          <div class="card-container">
            <div class="flex items-start gap-4">
              <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-brand-blush border border-brand-rose-border text-brand-rose">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
                </svg>
              </span>
              <div>
                <h3 class="text-base font-semibold text-primary mb-1">Support Email</h3>
                <p class="text-[13px] text-secondary leading-relaxed mb-3">
                  For feedback, bug reports, or general questions about our calculators.
                </p>
                <a href="mailto:contact@accurateovulationcalculator.com" class="inline-flex items-center gap-1.5 text-xs font-mono font-medium text-brand-rose bg-brand-blush px-3 py-1.5 rounded-full border border-brand-rose-border/50 hover:bg-brand-rose hover:text-white transition-colors">
                  contact@accurateovulationcalculator.com
                </a>
              </div>
            </div>
          </div>

          <!-- Business Inquiries Card -->
          <div class="card-container">
            <div class="flex items-start gap-4">
              <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-brand-sage-light border border-brand-sage text-brand-sage">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M20.25 14.15v4.25c0 1.094-.787 2.036-1.872 2.18-2.087.277-4.216.42-6.378.42s-4.291-.143-6.378-.42c-1.085-.144-1.872-1.086-1.872-2.18v-4.25m16.5 0a2.18 2.18 0 00.75-1.661V8.706c0-1.081-.768-2.015-1.837-2.175a48.114 48.114 0 00-3.413-.387m4.5 8.006c-.194.165-.42.295-.673.38A23.978 23.978 0 0112 15.75c-2.648 0-5.195-.429-7.577-1.22a2.016 2.016 0 01-.673-.38m0 0A2.18 2.18 0 013 12.489V8.706c0-1.081.768-2.015 1.837-2.175a48.111 48.111 0 013.413-.387m7.5 0V5.25A2.25 2.25 0 0013.5 3h-3a2.25 2.25 0 00-2.25 2.25v.894m7.5 0a48.667 48.667 0 00-7.5 0M12 12.75h.008v.008H12v-.008z" />
                </svg>
              </span>
              <div>
                <h3 class="text-base font-semibold text-primary mb-1">Business Inquiries</h3>
                <p class="text-[13px] text-secondary leading-relaxed mb-3">
                  For partnerships, collaborations, or press-related requests.
                </p>
                <a href="mailto:hello@accurateovulationcalculator.com" class="inline-flex items-center gap-1.5 text-xs font-mono font-medium text-brand-sage bg-brand-sage-light px-3 py-1.5 rounded-full border border-brand-sage/50 hover:bg-brand-sage hover:text-white transition-colors">
                  hello@accurateovulationcalculator.com
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Pre-Launch Notice Section -->
  <section class="bg-canvas-soft py-16 md:py-24">
    <div class="mx-auto max-w-7xl px-5 sm:px-6 lg:px-8">
      <div class="max-w-3xl mx-auto">
        <div class="card-container">
          <div class="flex items-start gap-4">
            <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-brand-lavender text-primary mt-0.5">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M11.25 11.25l.041-.02a.75.75 0 011.063.852l-.708 2.836a.75.75 0 001.063.853l.041-.021M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-9-3.75h.008v.008H12V8.25z" />
              </svg>
            </span>
            <div>
              <h3 class="text-base font-semibold text-primary mb-2">Pre-Launch Notice</h3>
              <div class="space-y-3 text-[15px] text-secondary leading-[1.8]">
                <p>
                  Accurate Ovulation is currently in its <strong class="text-primary font-medium">pre-launch phase</strong>. Official contact details — including a dedicated support email address and business inquiry channel — will be made available once the website launches publicly.
                </p>
                <p>
                  We appreciate your patience and look forward to connecting with you soon.
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- What You Can Reach Out About Section -->
  <section class="bg-canvas py-16 md:py-24">
    <div class="mx-auto max-w-7xl px-5 sm:px-6 lg:px-8">
      <div class="max-w-3xl mx-auto">
        <div class="text-center mb-10 md:mb-12">
          <span class="text-[11px] font-mono font-semibold tracking-widest text-brand-gold uppercase">
            We Welcome
          </span>
          <h2 class="text-2xl md:text-3xl font-semibold tracking-tight text-primary mt-3 mb-4">
            What You Can Reach Out About
          </h2>
        </div>

        <div class="space-y-4">
          <!-- Item 1 -->
          <div class="card-container flex items-start gap-4">
            <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-brand-blush text-brand-rose">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4">
                <path stroke-linecap="round" stroke-linejoin="round" d="M7.5 8.25h9m-9 3H12m-9.75 1.51c0 1.6 1.123 2.994 2.707 3.227 1.129.166 2.27.293 3.423.379.35.026.67.21.865.501L12 21l2.755-4.133a1.14 1.14 0 01.865-.501 48.172 48.172 0 003.423-.379c1.584-.233 2.707-1.626 2.707-3.228V6.741c0-1.602-1.123-2.995-2.707-3.228A48.394 48.394 0 0012 3c-2.392 0-4.744.175-7.043.513C3.373 3.746 2.25 5.14 2.25 6.741v6.018z" />
              </svg>
            </span>
            <div>
              <h3 class="text-sm font-semibold text-primary">Feedback & Suggestions</h3>
              <p class="text-[13px] text-secondary mt-1 leading-relaxed">
                Found our calculators helpful? Have an idea for a new feature or improvement? We'd love to hear your thoughts.
              </p>
            </div>
          </div>

          <!-- Item 2 -->
          <div class="card-container flex items-start gap-4">
            <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-brand-sage-light text-brand-sage">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 12.75c1.148 0 2.278.08 3.383.237 1.037.146 1.866.966 1.866 2.013 0 3.728-2.35 6.75-5.25 6.75S6.75 18.728 6.75 15c0-1.046.83-1.867 1.866-2.013A24.204 24.204 0 0112 12.75zm0 0c2.883 0 5.647.508 8.207 1.44a23.91 23.91 0 01-1.152 3.31M12 12.75c-2.883 0-5.647.508-8.208 1.44.125 1.15.394 2.26.793 3.31M12 12.75V7.5M6.75 5.25c0 1.657-.672 3.155-1.76 4.24m11.024 0c-1.089-1.085-1.764-2.583-1.764-4.24m-3 0a3 3 0 106 0 3 3 0 00-6 0z" />
              </svg>
            </span>
            <div>
              <h3 class="text-sm font-semibold text-primary">Bug Reports</h3>
              <p class="text-[13px] text-secondary mt-1 leading-relaxed">
                Noticed something that doesn't look right or isn't working as expected? Let us know so we can fix it promptly.
              </p>
            </div>
          </div>

          <!-- Item 3 -->
          <div class="card-container flex items-start gap-4">
            <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-brand-lavender text-primary">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9.879 7.519c1.171-1.025 3.071-1.025 4.242 0 1.172 1.025 1.172 2.687 0 3.712-.203.179-.43.326-.67.442-.745.361-1.45.999-1.45 1.827v.75M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-9 5.25h.008v.008H12v-.008z" />
              </svg>
            </span>
            <div>
              <h3 class="text-sm font-semibold text-primary">General Questions</h3>
              <p class="text-[13px] text-secondary mt-1 leading-relaxed">
                Have a question about how our calculators work, what methods we use, or our privacy practices? We're happy to help clarify.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Response Time Note -->
  <section class="bg-canvas-soft py-16 md:py-20">
    <div class="mx-auto max-w-7xl px-5 sm:px-6 lg:px-8">
      <div class="max-w-3xl mx-auto">
        <div class="rounded-xl bg-canvas p-6 md:p-8 border border-hairline shadow-md text-center">
          <div class="flex justify-center mb-4">
            <span class="flex h-12 w-12 items-center justify-center rounded-full bg-brand-blush text-brand-rose">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </span>
          </div>
          <h3 class="text-base font-semibold text-primary mb-2">Response Time</h3>
          <p class="text-sm text-secondary leading-relaxed max-w-md mx-auto">
            Once our contact channels are live, we aim to respond to all inquiries within <strong class="text-primary font-medium">1–2 business days</strong>. We value every message and will do our best to provide timely, helpful responses.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="bg-canvas py-16 md:py-20">
    <div class="mx-auto max-w-7xl px-5 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto">
        <h2 class="text-xl md:text-2xl font-semibold tracking-tight text-primary mb-4">
          Explore Our Calculators While You Wait
        </h2>
        <p class="text-sm text-secondary leading-relaxed mb-8 max-w-lg mx-auto">
          In the meantime, feel free to explore our free, private, and clinically-informed fertility tools.
        </p>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          <a href="/ovulation-calculator" class="btn-primary h-11 px-8 text-sm font-semibold shadow-md hover:shadow-lg transition-all duration-300">
            Try the Ovulation Calculator
          </a>
          <a href="/about" class="btn-secondary h-11 px-8 text-sm font-semibold shadow-sm hover:shadow-md transition-all duration-300">
            Learn About Us
          </a>
        </div>
      </div>
    </div>
  </section>

</Layout>
